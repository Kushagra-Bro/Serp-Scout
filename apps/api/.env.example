# ─────────────────────────────────────────────
# Serp-Scout — API .env.example
# ─────────────────────────────────────────────
# Safe to commit. Copy to .env and fill in real values.

NODE_ENV=development
PORT=3001

# Neon → https://console.neon.tech
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/serp-scout?sslmode=require

# Redis (local dev or Render Redis)
REDIS_URL=redis://localhost:6379

# Clerk → https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME

# SerpApi → https://serpapi.com/manage-api-key
SERPAPI_KEY=REPLACE_ME

# Groq → https://console.groq.com/keys
GROQ_API_KEY=gsk_REPLACE_ME
GROQ_MODEL=openai/gpt-oss-120b

# Resend → https://resend.com/api-keys
RESEND_API_KEY=re_REPLACE_ME
EMAIL_FROM=noreply@serp-scout.app

FRONTEND_URL=http://localhost:3000
DEFAULT_MONTHLY_QUOTA=500
