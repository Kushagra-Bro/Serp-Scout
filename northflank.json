{
  "version": "1.0",
  "name": "serp-scout",
  "description": "Serp-Scout: Autonomous AI Local SEO & SERP Radar Platform",
  "addons": [
    {
      "name": "serp-scout-postgres",
      "type": "postgres",
      "version": "16",
      "description": "Production PostgreSQL 16 database for workspaces, businesses, and SERP cache"
    },
    {
      "name": "serp-scout-redis",
      "type": "redis",
      "version": "7",
      "description": "Redis 7 instance for BullMQ background workers and scheduled SEO scans"
    }
  ],
  "services": [
    {
      "name": "serp-scout-api",
      "type": "deployment",
      "dockerfile": "Dockerfile.api",
      "ports": [
        {
          "port": 3001,
          "protocol": "HTTP",
          "public": true
        }
      ],
      "healthCheck": {
        "path": "/health",
        "port": 3001
      },
      "env": {
        "NODE_ENV": "production",
        "PORT": "3001",
        "GROQ_MODEL": "llama-3.3-70b-versatile",
        "DEFAULT_MONTHLY_QUOTA": "500"
      }
    },
    {
      "name": "serp-scout-web",
      "type": "deployment",
      "dockerfile": "Dockerfile.web",
      "ports": [
        {
          "port": 3000,
          "protocol": "HTTP",
          "public": true
        }
      ],
      "env": {
        "NODE_ENV": "production",
        "PORT": "3000",
        "NEXT_PUBLIC_CLERK_SIGN_IN_URL": "/sign-in",
        "NEXT_PUBLIC_CLERK_SIGN_UP_URL": "/sign-up",
        "NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL": "/app",
        "NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL": "/app",
        "NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL": "/app",
        "NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL": "/app"
      }
    }
  ]
}
